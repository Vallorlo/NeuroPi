{% extends 'motor_imagery/base.html' %}

{% block title %}Models - Motor Imagery BCI{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-cpu"></i> Trained Models</h1>
            <a href="{% url 'motor_imagery:train_model' %}" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Train New Model
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                {% if models %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Model Name</th>
                                    <th>Accuracy</th>
                                    <th>Created</th>
                                    <th>Status</th>
                                    <th>Sessions Used</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for model in models %}
                                    <tr>
                                        <td>
                                            <a href="{% url 'motor_imagery:model_detail' model.pk %}">
                                                {{ model.name }}
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">
                                                {{ model.accuracy|floatformat:2 }}%
                                            </span>
                                        </td>
                                        <td>{{ model.created_at|date:"M d, Y" }}</td>
                                        <td>
                                            {% if model.is_active %}
                                                <span class="status-active">● Active</span>
                                            {% else %}
                                                <span class="status-inactive">● Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ model.training_sessions.count }}</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{% url 'motor_imagery:model_detail' model.pk %}" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                                <a href="{% url 'motor_imagery:real_time_prediction' %}?model={{ model.pk }}" 
                                                   class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-broadcast"></i> Use
                                                </a>
                                                <a href="{% url 'motor_imagery:delete_model' model.pk %}" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-cpu fs-1 text-muted"></i>
                        <p class="mt-3 text-muted">No trained models yet.</p>
                        <a href="{% url 'motor_imagery:train_model' %}" class="btn btn-success">
                            Train First Model
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}